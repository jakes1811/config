"""
GOLD LAYER - FinTel Phase 4  (v3)

News re-enabled via STATIC AS-OF JOIN.

Four problems solved here:

1. Density
   ~56 articles over 11 days against 1-minute tick windows
   gives a window-equality join roughly a 1-in-280 hit rate.
   Instead we attach the most recent article at or before
   window_end, carried forward up to NEWS_MAX_AGE_HOURS.

2. Nanosecond timestamps
   The news parquet files were written by pandas/pyarrow with
   TIMESTAMP(NANOS). Spark's parquet reader rejects that type
   outright (PARQUET_TYPE_ILLEGAL). So news is read through
   pandas, downcast to microseconds, and handed to Spark.

3. Multi-ticker articles
   The news Silver stores matched_tickers as a LIST per
   article - one story can mention several symbols. We explode
   to one row per (article, ticker) pair before joining.

4. Python worker spawn on Windows
   createDataFrame(pandas) needs a Python worker. Spark spawns
   it as bare "python", which hits the Microsoft Store alias
   stub. We pin the interpreter, and keep a worker-free
   fallback via temp parquet round-trip.

Result: only ONE stateful operator (the tick window), no
watermark coupling between streams.
"""


import os
import sys

os.environ["PYSPARK_PYTHON"] = sys.executable
os.environ["PYSPARK_DRIVER_PYTHON"] = sys.executable

# Force all Spark-internal networking onto loopback.
# Without this, BlockManager registration can resolve to a
# null/ambiguous host and worker connect-back times out.
os.environ["SPARK_LOCAL_IP"] = "127.0.0.1"
os.environ["SPARK_LOCAL_HOSTNAME"] = "localhost"

import time

from pyspark.sql import functions as F
from pyspark.sql.streaming import StreamingQueryListener

from common import audit
from common.schemas import SILVER_TICKS_DDL
from common.tables import read_stream, write_batch
from config import settings


