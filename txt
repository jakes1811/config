    "sentiment",
    "label",
    "sentiment_class",
]

NEWS_HEADLINE_CANDIDATES = [
    "headline",
    "title",
    "news_title",
]

GOLD_COLUMNS = [
    "window_start",
    "window_end",
    "symbol",
    "article_count",
    "avg_sentiment",
    "min_sentiment",
    "latest_headline",
    "latest_sentiment_label",
