python -c "import pandas as pd,glob; fs=glob.glob('data/silver/news/**/*.parquet',recursive=True); d=pd.concat([pd.read_parquet(f,columns=['published_at','matched_tickers']) for f in fs],ignore_index=True); t=pd.to_datetime(d.published_at,utc=True,errors='coerce'); print('TOTAL ARTICLES:',len(d)); print('VALID TIMESTAMPS:',t.notna().sum()); print('OLDEST NEWS:',t.min()); print('LATEST NEWS:',t.max()); print('NEWS BY DATE:'); print(t.dt.date.value_counts().sort_index().to_string())"
