python -c "import pandas as pd,glob; fs=glob.glob(r'..\Market_ticker\silver\data\stock_silver\**\*.parquet',recursive=True); fs=[f for f in fs if '_delta_log' not in f]; d=pd.concat([pd.read_parquet(f,columns=['symbol','market_timestamp','publication_timestamp','current_price']) for f in fs],ignore_index=True); print('TOTAL TICKS:',len(d)); print('SYMBOLS:',sorted(d.symbol.dropna().unique())); print('\nMARKET TIMESTAMP:'); print('OLDEST:',d.market_timestamp.min()); print('LATEST:',d.market_timestamp.max()); print('\nPUBLICATION TIMESTAMP:'); print('OLDEST:',d.publication_timestamp.min()); print('LATEST:',d.publication_timestamp.max()); print('\nNULL MARKET TIMESTAMPS:',d.market_timestamp.isna().sum()); print('NULL PUBLICATION TIMESTAMPS:',d.publication_timestamp.isna().sum()); print('\nSAMPLE:'); print(d.head(5).to_string(index=False))"
